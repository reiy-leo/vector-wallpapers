{
  "name": "vector-wallpapers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯函数 SVG 壁纸生成器 —— 可拆解为可独立配色元件的 Pattern 母题",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "verify": "node node_modules/vitest/vitest.mjs run src/__verify__/verify.test.ts",
    "deploy": "npm run build && node node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
