{
  "name": "vector-wallpapers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯函数 SVG 壁纸生成器 —— 可拆解为可独立配色元件的 Pattern 母题",
  "scripts": {
    "dev": "npm --prefix . run _vite",
    "build": "npm --prefix . run _vite -- build",
    "preview": "npm --prefix . run _vite -- preview",
    "typecheck": "npm --prefix . run _tsc -- --noEmit",
    "test": "npm --prefix . run _vitest -- run",
    "test:watch": "npm --prefix . run _vitest",
    "test:coverage": "npm --prefix . run _vitest -- run --coverage",
    "verify": "npm --prefix . run _vitest -- run src/__verify__/verify.test.ts",
    "deploy": "npm run build && npm --prefix . run _wrangler -- deploy",
    "_vite": "node node_modules/vite/bin/vite.js",
    "_vitest": "node node_modules/vitest/vitest.mjs",
    "_tsc": "node node_modules/typescript/bin/tsc",
    "_wrangler": "node node_modules/wrangler/bin/wrangler.js",
    "dev:worker": "npm run build && npm --prefix . run _wrangler -- dev"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
