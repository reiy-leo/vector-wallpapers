{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 与 wrangler.jsonc 同一个 Worker，区别只在静态资源：这里把 dist/ 内联进脚本（见 worker-inline/entry.ts）。
  // 用于 API Token 部署（Static Assets 上传接口不可用的环境）：npm run deploy:inline
  "name": "vector-wallpapers",
  "main": "worker-inline/entry.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "routes": [{ "pattern": "vector-wallpapers.rei8t.dev", "custom_domain": true }],
  "preview_urls": false,
  // 部署时保留控制台里加的变量（GOOGLE_CLIENT_ID 等），不被这里的 vars 覆盖
  "keep_vars": true,
  "vars": {
    "ALLOWED_EMAIL_DOMAINS": "*",
    // 可访问 /api/ratings/summary（评分汇总 / CSV）的管理员邮箱，逗号分隔
    "ADMIN_EMAILS": "reiy.leoz@gmail.com,raylee.stu@gmail.com,ryan.lincs@outlook.com"
  },

  // 「色板 × 母题」评分：每个用户一个 key `u:<userhash>`（见 src/worker/ratings.ts）
  "kv_namespaces": [
    { "binding": "RATINGS", "id": "7f7bd2a10ac04582a7be854c535b7a55" }
  ],
  "observability": {
    "enabled": true
  }
}
